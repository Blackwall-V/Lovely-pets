#!/usr/bin/env python3
"""Wrapper that launches pet.py under the binary name ``lovely-pet``.

The Qt 6 Wayland backend (verified on Arch with qt6-wayland 6.11)
derives the xdg-shell ``app_id`` from the *executable's* path
basename — there is no env-var override and ``QApplication``'s
``applicationName`` is ignored. Since we run pet.py as
``python pet.py``, the executable is ``/usr/bin/python3.14`` and
Hyprland sees the window class as ``python3``.

This wrapper re-execs Python with ``argv[0]`` set to this script's
own path, so Qt sees a binary basename of ``lovely-pet`` and
Hyprland's ``class:^(lovely-pet)$`` windowrulev2 rules finally
match.

Usage:
    ./lovely-pet                       # bundled sample
    ./lovely-pet /path/to/pet.gif      # custom pet
    ./lovely-pet --size 50 --corner top-left
    ./lovely-pet --init-config         # bootstrap config
"""
import os
import sys


def main() -> int:
    project_dir = os.path.dirname(os.path.abspath(__file__))
    venv_python = os.path.join(project_dir, ".venv", "bin", "python")

    # Re-exec Python with argv[0] set to this script. The kernel
    # records the new executable in /proc/PID/exe, which is what Qt
    # reads via QCoreApplication::applicationFilePath().
    if sys.executable != venv_python and os.path.isfile(venv_python):
        os.execv(
            venv_python,
            [os.path.abspath(__file__), os.path.join(project_dir, "pet.py"), *sys.argv[1:]],
        )

    # Already running under the venv python; just import and run.
    sys.path.insert(0, project_dir)
    from pet import main as _pet_main
    return _pet_main()


if __name__ == "__main__":
    sys.exit(main())
